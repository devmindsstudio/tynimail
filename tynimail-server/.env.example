# ========================================
# TYNIMAIL SERVER ENVIRONMENT CONFIGURATION
# ========================================
# Copy this file to create your environment-specific files:
# - .env.local (for local development)
# - .env.development (for development environment)
# - .env.staging (for staging environment)
# - .env.production (for production environment)

# ========================================
# SERVER CONFIGURATION
# ========================================
# Port on which the server will run
PORT=3000

# Environment mode: local | development | staging | production
NODE_ENV=development

# Public base URL of the server — used in tracker.js to build the /t/e endpoint URL
# e.g. https://app.tynimail.com  (no trailing slash)
APP_URL=http://localhost:3000

# ========================================
# DATABASE CONFIGURATION
# ========================================
# PostgreSQL database connection settings
DB_HOST=your_database_host
DB_PORT=5432
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=your_database_name

# Enable SSL for database connection (true for production, false for local)
DB_SSL=true

# ========================================
# JWT CONFIGURATION
# ========================================
# Generate secure secrets using:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

# Secret key for access token encryption (REQUIRED - Generate unique value)
JWT_ACCESS_SECRET=your_generated_access_secret_key_here

# Secret key for refresh token encryption (REQUIRED - Generate unique value)
JWT_REFRESH_SECRET=your_generated_refresh_secret_key_here

# Token expiration times
# Access token: Short-lived (15 minutes recommended)
JWT_ACCESS_EXPIRATION=15m

# Refresh token: Long-lived (7 days recommended)
JWT_REFRESH_EXPIRATION=7d

# ========================================
# CORS CONFIGURATION
# ========================================
# Allowed origins for CORS (comma-separated for multiple origins)
# Examples:
# - Local: http://localhost:3000,http://localhost:3001
# - Production: https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGIN=http://localhost:3000

# ========================================
# POSTMARK CONFIGURATION
# ========================================
# Need to ensure to use separate tokens for postmark
# Server token to send emails, and Account token to verify domains, emails, etc.
POSTMARK_API_ACCOUNT_TOKEN=your_postmark_account_token
POSTMARK_API_SERVER_TOKEN=your_postmark_server_token
POSTMARK_API_URL=postmark_api_url
POSTMARK_FROM_EMAIL=
# ========================================
# EMAIL VERIFICATION SERVICE
# ========================================
# Million Verifier API key for email validation
# Get your API key from: https://www.millionverifier.com
MILLION_VERIFIER_API_KEY=your_million_verifier_api_key

# ========================================
# REDIS CONFIGURATION (BullMQ)
# ========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ========================================
# ADMIN / BULL BOARD
# ========================================
# Static token required in X-Admin-Token header to access /admin/queues
# Leave empty to disable auth (local dev only)
ADMIN_QUEUE_TOKEN=your-secure-random-token-here

# ========================================
# AWS S3 Bucket
# ========================================
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ========================================
# NOTES
# ========================================
# 1. Never commit actual .env files with real credentials to version control
# 2. Generate unique JWT secrets for each environment
# 3. Use strong, random passwords for database credentials
# 4. Keep production secrets secure and rotate them regularly
# 5. Enable DB_SSL=true for all remote/cloud database connections
# 6. In local development, you may set DB_SSL=false for local PostgreSQL
